# Copy this file to .env and fill in your real values.
# .env is already in .gitignore. Never commit real credentials.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fleet_management
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

PORT=5000

# Once the site is hosted, set this to your frontend's address so only it can call the API
# (comma-separated for more than one). Leave it unset while working locally.
# CORS_ORIGIN=https://your-frontend.example.com
